QWidget {
    background-color: transparent;
    color: #e6edf3;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
}

/* ---------- Auth cards ---------- */

QFrame#card {
    background-color: rgba(13, 20, 33, 235);
    border: 1px solid rgba(79, 163, 255, 60);
    border-radius: 16px;
}

QLabel#title {
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#subtitle {
    font-size: 13px;
    color: #8ea3c0;
    margin-bottom: 6px;
}

QLabel#mutedLabel {
    color: #8ea3c0;
    font-size: 12px;
}

QLineEdit {
    background-color: #0d1117;
    border: 1px solid #1f2b3d;
    border-radius: 8px;
    padding: 10px 12px;
    color: #ffffff;
    selection-background-color: #4fa3ff;
}

QLineEdit:focus {
    border: 1px solid #4fa3ff;
}

QPushButton#primaryBtn {
    background-color: #1f6feb;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-weight: 600;
    letter-spacing: 1px;
}

QPushButton#primaryBtn:hover {
    background-color: #388bfd;
}

QPushButton#primaryBtn:pressed {
    background-color: #1158c7;
}

QPushButton#linkBtn {
    background: transparent;
    color: #4fa3ff;
    border: none;
    font-weight: 600;
}

QPushButton#linkBtn:hover {
    color: #7ec8ff;
    text-decoration: underline;
}

QPushButton#refreshBtn {
    background-color: #1f2b3d;
    border: none;
    border-radius: 8px;
    color: #4fa3ff;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#refreshBtn:hover {
    background-color: #2a3b52;
}

/* ---------- Dashboard ---------- */

QFrame#sidebar {
    background-color: #060a12;
    border-right: 1px solid #1f2b3d;
}

QLabel#logo {
    font-size: 18px;
    font-weight: 700;
    color: #4fa3ff;
}

QLabel#navSection {
    color: #4a5b76;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

QPushButton#navBtn {
    text-align: left;
    background-color: transparent;
    color: #c7d5e6;
    border: none;
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 14px;
}

QPushButton#navBtn:hover {
    background-color: #10192b;
    color: #ffffff;
}

QPushButton#navBtn:checked {
    background-color: #12233d;
    color: #4fa3ff;
    font-weight: 600;
}

QPushButton#logoutBtn {
    text-align: left;
    background-color: transparent;
    color: #ff6b6b;
    border: none;
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 14px;
}

QPushButton#logoutBtn:hover {
    background-color: #2a1414;
}

QFrame#header {
    background-color: #060a12;
    border-bottom: 1px solid #1f2b3d;
}

QLabel#headerTitle {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
}

QLabel#headerWelcome {
    font-size: 13px;
    color: #8ea3c0;
}

QFrame#central {
    background-color: #0b0f18;
}

QLabel#statsLabel {
    font-size: 14px;
    font-weight: 600;
    color: #4fa3ff;
}

QPushButton#secondaryBtn {
    background-color: #1f2b3d;
    color: #e6edf3;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
}

QPushButton#secondaryBtn:hover {
    background-color: #2a3b52;
}

QTableWidget {
    background-color: #0d1117;
    border: 1px solid #1f2b3d;
    border-radius: 8px;
    gridline-color: #1f2b3d;
    color: #e6edf3;
    alternate-background-color: #10151f;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #1f6feb;
    color: white;
}

QHeaderView::section {
    background-color: #10192b;
    color: #4fa3ff;
    padding: 8px;
    border: none;
    font-weight: 600;
}

QScrollBar:vertical {
    background: #0b0f18;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #1f2b3d;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #2a3b52;
}

QFrame#footer {
    background-color: #060a12;
    border-top: 1px solid #1f2b3d;
}

QLabel#footerLabel {
    color: #5a6b85;
    font-size: 11px;
}

QMessageBox {
    background-color: #0d1117;
}
